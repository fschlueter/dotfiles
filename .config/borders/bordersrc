#!/bin/bash
# JankyBorders config, run by `borders` at start (no args). Rerun to apply changes live (alias borders-reload):
# calling `borders <args>` while it runs updates the running instance.
# Colors as herdr draws its pane borders with theme "terminal" (focused: accent = magenta = slot 5,
# others: ratatui Gray = slot 7), taken from the herdr Ghostty theme (`theme --herdr`, see ~/.local/bin/theme).

ACTIVE_SLOT=5
INACTIVE_SLOT=7

# theme file: herdr's (`theme --herdr`, by default the terminal theme)
theme_file="$("$HOME/.local/bin/theme" --file herdr 2>/dev/null)"

# Prints palette slot $1 of the theme as rrggbb
slot() {
	[[ -f "$theme_file" ]] || return 0
	sed -nE "s/^palette *= *$1 *= *#?([0-9a-fA-F]{6}).*/\1/p" "$theme_file" | tail -1
}
active_hex="$(slot "$ACTIVE_SLOT")"
inactive_hex="$(slot "$INACTIVE_SLOT")"

# No focused border where it adds nothing: focused window floating, in an accordion, AeroSpace-fullscreen
# or the only tiled window on its workspace.
# AeroSpace runs this with "hook" on focus change and after layout/fullscreen bindings; a closed window can
# still be listed at that moment, so the hook checks once more shortly after.
apply() {
	local active="0xe6${active_hex:-c4a7e7}" state tiled  # 0xAARRGGBB
	state="$(aerospace list-windows --focused --format '%{window-parent-container-layout} %{window-is-fullscreen}' 2>/dev/null)"
	tiled="$(aerospace list-windows --workspace focused --format '%{window-parent-container-layout}' 2>/dev/null |
		grep -cv '^floating')"
	case "$state" in
		floating* | *accordion* | *true) active=0x00000000 ;;
		*) [[ "$tiled" -le 1 ]] && active=0x00000000 ;;
	esac
	borders style=round width=5.0 hidpi=on ax_focus=on \
		active_color="$active" inactive_color="0xe6${inactive_hex:-e0def4}"
}

apply
if [[ "$1" == hook ]]; then
	sleep 0.3
	apply
fi
