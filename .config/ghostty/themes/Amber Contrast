# Matrix Contrast's slot plan in amber: all warm (no blue/cyan/pink), hues spread from red-orange to olive so
# diffs, git status and syntax stay readable. See Matrix Contrast for what uses each slot.
# UI accents read from these slots: herdr accent (active tab, focused border) = 5; Claude Code dark-ansi:
# brand = 9, permission/suggestion = 12, auto-accept/bash border = 13, plan mode = 14; statusline model = 6.
# Used for herdr panes via `herdr-theme 'Amber Contrast'` (.env/tools/herdr); usable as a Ghostty theme too.

# 0 black: zsh-hl comments, dim UI bits, herdr active sidebar row (raised from #2e2418 for that)
palette = 0 = #3e3020
# 1 "red": git removed lines (-), unstaged files, errors
palette = 1 = #ff4d2e
# 2 "green" (gold here): git added lines (+), staged files, valid commands
palette = 2 = #ffc93d
# 3 yellow (pale): commit hashes, section headers, quoted strings
palette = 3 = #ffe39a
# 4 blue (dark amber): directories, globs
palette = 4 = #d08a2a
# 5 magenta (amber accent): images/media in ls, redirections, herdr accent
palette = 5 = #ffb000
# 6 cyan (olive gold): diff hunk headers, symlinks
palette = 6 = #c8c060
# 7 white: default text where programs set it explicitly (git diff context lines use the default foreground, dimmed)
palette = 7 = #dccab0
# 8 bright black: zsh-autosuggestions, other dimmed hints
palette = 8 = #8c7a64
# 9 bright red: emphasized removals in word diffs
palette = 9 = #ff8a6a
# 10 bright green (light gold): regular files (LS_COLORS fi=92), emphasized additions
palette = 10 = #ffe2a6
# 11 bright yellow (deep orange): warnings, search matches
palette = 11 = #ff7a00
# 12 bright blue: links and emphasis in TUI tools
palette = 12 = #ffd27a
# 13 bright magenta: emphasized special items
palette = 13 = #ff9e5e
# 14 bright cyan: emphasized info
palette = 14 = #e0dc9a
# 15 bright white: bold headings
palette = 15 = #fff2dc

background = #17110a
foreground = #ffa23a
cursor-color = #ffb000
cursor-text = #17110a

selection-background = #4a3214
selection-foreground = #ffd27a
