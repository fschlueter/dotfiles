# Matrix with raised contrast: green-dominant, but ANSI hues kept distinguishable
# (real red/blue/magenta accents so diffs, git status and syntax stay readable)
#
# Slots 0-7 are the normal ANSI colors, 8-15 the bright variants.
# Programs pick colors by slot number, so the comments say what each is used for.
# ls = GNU ls via `gdircolors -b` defaults; "zsh-hl" = zsh-syntax-highlighting defaults.
# Ghostty does not brighten bold text, so "bold blue" (dirs) is still slot 4, just heavier.

# 0 black: zsh-hl comments (bold black, nearly invisible on the background), dim UI bits
palette = 0 = #24363a
# 1 "red" (lime-yellow here, like oh-my-posh):
#   git: removed lines (-), unstaged/untracked/deleted files in `git status`, remote branches
#   ls:  archives (tar, zip, gz), broken symlinks; zsh-hl: unknown commands/errors
palette = 1 = #faff00
# 2 green:
#   git: added lines (+), staged files in `git status`, current branch in `git branch`
#   ls:  executables; zsh-hl: valid commands, builtins, aliases, functions
palette = 2 = #39ff14
# 3 yellow:
#   git: commit hashes in `git log`, `git status` section headers, tags
#   zsh-hl: reserved words (if, for, ...) and quoted strings
palette = 3 = #ffe600
# 4 blue (dark green here, so dirs fit the Matrix look):
#   ls: directories; zsh-hl: globs (*, ?); git: nothing by default
palette = 4 = #27b35a
# 5 magenta (cyan-blue here, purple didn't fit Matrix):
#   ls: images (png, jpg), video, audio, sockets; zsh-hl: redirections (>, |)
palette = 5 = #33ccff
# 6 cyan:
#   git: diff hunk headers (@@ ... @@), HEAD in `git log` decorations
#   ls:  symlinks
palette = 6 = #00ffe0
# 7 white: default/context text where programs set it explicitly (e.g. unchanged diff lines)
palette = 7 = #c8d8c4
# 8 bright black (gray): zsh-autosuggestions (inline ghost text), other "dimmed" hints
palette = 8 = #6f9468
# 9 bright red (amber): emphasized removals in word-level diffs (delta, diff-highlight), if used
palette = 9 = #ffd066
# 10 bright green: regular files in ls/completion (via LS_COLORS fi=92 in .zshrc),
#    emphasized additions in word-level diffs, if used
palette = 10 = #9dffb4
# 11 bright yellow (orange here): highlighted warnings, search matches in some pagers
palette = 11 = #ffb31a
# 12 bright blue: links and emphasis in TUI tools (nvim, yazi, ...)
palette = 12 = #6fd0ff
# 13 bright magenta (light cyan-blue here): emphasized special items in TUI tools
palette = 13 = #8fe3ff
# 14 bright cyan: emphasized info in TUI tools
palette = 14 = #8dfff2
# 15 bright white: bold headings, strong emphasis
palette = 15 = #e6ffe0

# Default text (plain output, typed arguments), background and cursor
background = #0f191c
foreground = #8fa596
cursor-color = #11ff25
cursor-text = #0f191c

# Selected text (mouse selection)
selection-background = #1f4a3a
selection-foreground = #00ff87
