# Ghostty's bundled Rose Pine with a brighter "green" (pine): git's added lines (+) were 3.4:1 on the
# background, now 6.2:1 like red (-). All other colors unchanged.
# Used for herdr panes via `herdr-theme 'Rose Pine Contrast'` (.env/tools/herdr); usable as a Ghostty theme too.

palette = 0 = #26233a
palette = 1 = #eb6f92
# 2 "green" (pine): git added lines (+), staged files, valid commands; bundled: #31748f
palette = 2 = #4fa3c4
palette = 3 = #f6c177
palette = 4 = #9ccfd8
palette = 5 = #c4a7e7
palette = 6 = #ebbcba
palette = 7 = #e0def4
palette = 8 = #6e6a86
palette = 9 = #eb6f92
# 10 bright green (pine): regular files (LS_COLORS fi=92), emphasized additions; bundled: #31748f
palette = 10 = #6cc0dc
palette = 11 = #f6c177
palette = 12 = #9ccfd8
palette = 13 = #c4a7e7
palette = 14 = #ebbcba
palette = 15 = #e0def4

background = #191724
foreground = #e0def4
cursor-color = #e0def4
cursor-text = #191724
selection-background = #403d52
selection-foreground = #e0def4
