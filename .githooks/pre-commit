#!/usr/bin/env bash
# Checks staged changes (the index, not the working tree, so partially staged files are checked as committed):
# 1. secrets: gitleaks if installed, else a dependency-free regex scan
# 2. shell syntax: `bash -n` / `zsh -n`; shellcheck (config in .shellcheckrc) if installed
# Bypass a false positive with `git commit --no-verify`.
fail=0

# --- 1. Secrets
if command -v gitleaks >/dev/null; then
    gitleaks git --pre-commit --staged --redact -v --no-banner --log-level warn || fail=1
else
    patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----'
    patterns+='|AKIA[0-9A-Z]{16}'
    patterns+='|gh[pousr]_[A-Za-z0-9]{36,}'
    patterns+='|github_pat_[A-Za-z0-9_]{50,}'
    patterns+='|sk-[A-Za-z0-9_-]{20,}'
    patterns+='|xox[baprs]-[A-Za-z0-9-]{10,}'
    patterns+='|(api[_-]?key|secret|token|passw(or)?d)[A-Za-z0-9_]*["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'$ ]{12,}["'"'"']'

    hits=$(git diff --cached --no-color -U0 --diff-filter=ACM | grep -nE '^\+[^+]' | grep -iE -e "$patterns")
    if [[ -n "$hits" ]]; then
        echo "pre-commit: possible secret in staged changes:" >&2
        echo "$hits" | cut -c1-160 >&2
        fail=1
    fi
fi

# --- 2. Shell files. .env/* is sourced by both shells, so it gets both syntax checks.
while IFS= read -r f; do
    case "$f" in
        .zshrc | *.zsh) shells="zsh" ;;
        .bashrc | install.sh | .githooks/*) shells="bash" ;;
        .env/*) shells="bash zsh" ;;
        *) continue ;;
    esac
    for sh in $shells; do
        command -v "$sh" >/dev/null || continue
        git show ":$f" | "$sh" -n 2>&1 | sed "s|^|$f ($sh -n): |" | grep . >&2 && fail=1
    done
    if [[ $shells == *bash* ]] && command -v shellcheck >/dev/null; then
        git show ":$f" | shellcheck -f gcc - | sed "s|^-:|$f:|" | grep . >&2 && fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

exit $fail
