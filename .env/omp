# Prompt engine
omp_dir="$HOME/.config/ohmyposh"
mkdir -p "$omp_dir"
touch "$omp_dir/theme"

if ! command -v oh-my-posh >/dev/null; then
    echo "oh-my-posh not found, installing ..."
    if [[ "$OSTYPE" == darwin* ]]; then
        brew install jandedobbeleer/oh-my-posh/oh-my-posh
    else
        mkdir -p "$HOME/.local/bin"
        curl -s https://ohmyposh.dev/install.sh | bash -s -- -d "$HOME/.local/bin"
    fi
fi

# CPU/GPU usage for the prompt: read the cache from the previous sample (no
# fork), then refresh it in the background. Must be registered before omp init.
_omp_sysload() {
    local f="${XDG_CACHE_HOME:-$HOME/.cache}/ohmyposh/sysload" v
    if [[ -r $f ]]; then
        v=("${(@f)$(<$f)}")
        export OMP_CPU=${v[1]} OMP_GPU=${v[2]}
    fi
    {
        local ncpu=$(sysctl -n hw.ncpu)
        local cpu=$(ps -A -o %cpu | awk -v n=$ncpu 'NR>1{s+=$1} END{s=s/n; printf "%d", (s>100?100:s)}')
        local gpu=$(ioreg -r -c IOAccelerator | grep -o '"Device Utilization %"=[0-9]*' | head -1 | cut -d= -f2)
        printf '%s\n%s\n' "$cpu" "$gpu" > "$f"
    } &!
}
if [[ "$OSTYPE" == darwin* ]]; then
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd _omp_sysload
fi

export POSH_THEME="$(cat "$omp_dir/theme")"  # persisted by `posh-theme`
# oh-my-posh has no config imports: assemble base config + themes/*.toml
omp_cfg="${XDG_CACHE_HOME:-$HOME/.cache}/ohmyposh/config.toml"
mkdir -p "${omp_cfg%/*}"
cat "$omp_dir/omp.toml" "$omp_dir"/themes/*.toml > "$omp_cfg"
eval "$(oh-my-posh init zsh --config "$omp_cfg")"
unset omp_dir omp_cfg

# oh-my-posh theme switcher: picks a color palette from themes/*.toml
# and persists it so new shells keep using it.
function posh-theme() {
    local state="$HOME/.config/ohmyposh/theme"
    local themes=($(ls ~/.config/ohmyposh/themes | sed 's/\.toml$//'))

    if [[ -z "$1" ]]; then
        echo "Current: ${POSH_THEME:-default}"
        echo "Available: ${themes[*]}"
        return
    fi
    if [[ ! " ${themes[*]} " == *" $1 "* ]]; then
        echo "Unknown theme '$1'. Available: ${themes[*]}" >&2
        return 1
    fi

    export POSH_THEME="$1"
    echo "$1" > "$state"
}
