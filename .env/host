# shellcheck shell=bash
# Host profile: sets per-host flags from .env/hosts/<profile> (sourced by .zshrc and install.sh, bash + zsh).
# The profile is the first that exists of: $DOTFILES_HOST, the first line of ~/.config/dotfiles/host
# (untracked override), `hostname -s`; otherwise the OS default (hosts/darwin or hosts/linux).
# Profiles may set:
#   DOTFILES_STOW_IGNORE  space-separated stow ignore regexes, matched against paths like `.config/ghostty`
#                         (install.sh passes them as --ignore; no leading `^/`, unlike .stow-local-ignore)
#   DOTFILES_NVIM_AI      space-separated AI nvim plugins to load (claudecode, minuet); read by nvim

_dotfiles_env="${DOTFILES_ENV_DIR:-$HOME/.env}"  # install.sh points this at the repo
_h="${DOTFILES_HOST-}"
[[ -z $_h && -r "$HOME/.config/dotfiles/host" ]] && read -r _h < "$HOME/.config/dotfiles/host"
[[ -z $_h ]] && _h="$(hostname -s 2>/dev/null)"
_h="${_h//\//_}"  # hostnames come from outside: keep the lookup inside hosts/

case "$OSTYPE" in
    darwin*) _p=darwin ;;
    *) _p=linux ;;
esac
[[ -n $_h && -r "$_dotfiles_env/hosts/$_h" ]] && _p="$_h"

DOTFILES_STOW_IGNORE=""
DOTFILES_NVIM_AI=""
# shellcheck disable=SC1090
. "$_dotfiles_env/hosts/$_p"
export DOTFILES_PROFILE="$_p" DOTFILES_NVIM_AI
unset _h _p _dotfiles_env
