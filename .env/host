# shellcheck shell=bash
# Host profile: loads .env/hosts/<profile> and exports its settings. Sourced by .zshrc and install.sh (bash + zsh).
#
# Profile, first match wins (a candidate only counts if .env/hosts/<name> exists):
#   1. $DOTFILES_HOST
#   2. first line of ~/.config/dotfiles/host  (per-host override, lives outside the repo)
#   3. `hostname -s`
#   4. OS default: hosts/darwin on macOS, hosts/linux otherwise
# Only that one file is loaded; a hostname profile does not inherit from the OS default.
#
# A profile may set (and hold aliases/exports for that host):
#   DOTFILES_STOW_IGNORE  stow --ignore regexes, space-separated, e.g. `\.config/ghostty` (no leading `^/`); used by install.sh
#   DOTFILES_NVIM_AI      AI nvim plugins to load (claudecode, minuet); read by lua/config/dotfiles.lua
#   DOTFILES_SHELL        zsh (default). Anything else only prints a warning: no .bashrc is shipped yet.

_dotfiles_env="${DOTFILES_ENV_DIR:-$HOME/.env}"  # install.sh points this at the repo
_h="${DOTFILES_HOST-}"
[[ -z $_h && -r "$HOME/.config/dotfiles/host" ]] && read -r _h < "$HOME/.config/dotfiles/host"
[[ -z $_h ]] && _h="$(hostname -s 2>/dev/null)"
_h="${_h//\//_}"  # hostnames come from outside: keep the lookup inside hosts/

case "$OSTYPE" in
    darwin*) _p=darwin ;;
    *) _p=linux ;;
esac
[[ -n $_h && -r "$_dotfiles_env/hosts/$_h" ]] && _p="$_h"

DOTFILES_STOW_IGNORE=""
DOTFILES_NVIM_AI=""
DOTFILES_SHELL=zsh
# shellcheck disable=SC1090
. "$_dotfiles_env/hosts/$_p"
export DOTFILES_PROFILE="$_p" DOTFILES_NVIM_AI DOTFILES_SHELL

if [[ $DOTFILES_SHELL != zsh ]]; then
    echo "dotfiles: warning: profile '$_p' wants shell '$DOTFILES_SHELL', but only zsh is configured (no .bashrc shipped)" >&2
fi
[[ $- == *i* ]] && echo "dotfiles: profile '$_p' (host '$_h')"  # interactive shells only, not install.sh
unset _h _p _dotfiles_env
