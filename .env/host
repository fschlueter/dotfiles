# shellcheck shell=bash
# Host profile: loads .env/hosts/<profile> and exports its settings. Sourced by .zshrc, .bashrc and install.sh.
#
# Profile, first match wins (a candidate only counts if .env/hosts/<name> exists):
#   1. $DOTFILES_HOST
#   2. first line of ~/.config/dotfiles/host  (per-host override, lives outside the repo)
#   3. `hostname -f` (the FQDN, because short names collide: two different hosts are called `rno-g`;
#      falls back to `hostname -s` if that prints nothing)
#   4. OS default: hosts/darwin on macOS, hosts/linux otherwise
# The OS default is always loaded first; a hostname profile is loaded on top and only needs the differences.
#
# A profile may set (and hold aliases/exports for that host):
#   DOTFILES_STOW_IGNORE  stow --ignore regexes, space-separated, e.g. `\.config/ghostty` (no leading `^/`); used by install.sh
#   DOTFILES_NVIM_AI      AI nvim plugins to load (claudecode, minuet); read by lua/config/dotfiles.lua
#   DOTFILES_AUTO_INSTALL 1 (default) installs missing fzf/zoxide/uv/oh-my-posh at shell start; 0 skips that.
#                         A DOTFILES_AUTO_INSTALL set in the environment wins over the profile.
#                         With a home shared between servers, put `DOTFILES_AUTO_INSTALL=0` into .env/hosts/<FQDN>.

_dotfiles_env="${DOTFILES_ENV_DIR:-$HOME/.env}"  # install.sh points this at the repo
_h="${DOTFILES_HOST-}"
[[ -z $_h && -r "$HOME/.config/dotfiles/host" ]] && read -r _h < "$HOME/.config/dotfiles/host"
[[ -z $_h ]] && _h="$(hostname -f 2>/dev/null)"
[[ -z $_h ]] && _h="$(hostname -s 2>/dev/null)"
_h="${_h//\//_}"  # hostnames come from outside: keep the lookup inside hosts/

case "$OSTYPE" in
    darwin*) _p=darwin ;;
    *) _p=linux ;;
esac
_ai="${DOTFILES_AUTO_INSTALL-}"

DOTFILES_STOW_IGNORE=""
DOTFILES_NVIM_AI=""
DOTFILES_AUTO_INSTALL=1
# shellcheck disable=SC1090
. "$_dotfiles_env/hosts/$_p"
if [[ -n $_h && $_h != "$_p" && -r "$_dotfiles_env/hosts/$_h" ]]; then
    _p="$_h"
    . "$_dotfiles_env/hosts/$_h"
fi
DOTFILES_AUTO_INSTALL="${_ai:-$DOTFILES_AUTO_INSTALL}"
export DOTFILES_PROFILE="$_p" DOTFILES_NVIM_AI DOTFILES_AUTO_INSTALL

# Interactive shells only (not install.sh)
if [[ $- == *i* ]]; then  # plain `[[ ]] && echo` would return 1 here and abort install.sh (set -e)
    echo "dotfiles: profile '$DOTFILES_PROFILE' (host '$_h', shell ${ZSH_VERSION:+zsh}${BASH_VERSION:+bash})"
fi
unset _h _p _ai _dotfiles_env
