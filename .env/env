# shellcheck shell=bash

# Add a dir to a colon-separated path variable, skipping duplicates (bash + zsh).
# Usage: path_append VAR DIR / path_prepend VAR DIR
path_append() {
    local cur
    eval "cur=\${$1-}"
    case ":$cur:" in
        *":$2:"*) ;;
        *) export "$1=${cur:+$cur:}$2" ;;
    esac
}
path_prepend() {
    local cur
    eval "cur=\${$1-}"
    case ":$cur:" in
        *":$2:"*) ;;
        *) export "$1=$2${cur:+:$cur}" ;;
    esac
}

