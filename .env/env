# shellcheck shell=bash

# Add a dir to a colon-separated path variable, skipping duplicates (bash + zsh).
# path_append also skips entries that do not exist (-e, so zip/egg files in PYTHONPATH work too).
# Usage: path_append VAR DIR / path_prepend VAR DIR
path_append() {
    local cur
    [[ -e $2 ]] || return 0
    eval "cur=\${$1-}"
    case ":$cur:" in
        *":$2:"*) ;;
        *) export "$1=${cur:+$cur:}$2" ;;
    esac
}
path_prepend() {
    local cur
    eval "cur=\${$1-}"
    case ":$cur:" in
        *":$2:"*) ;;
        *) export "$1=$2${cur:+:$cur}" ;;
    esac
}

export SOFTWARE="${SOFTWARE:-$HOME/software}"  # a host profile (.env/hosts/) can set it first

# Searches for folders in $ENVS_DIR and creates alias for each virt env
export ENVS_DIR="${ENVS_DIR:-$SOFTWARE/envs}"
if [[ -d $ENVS_DIR ]]; then
    for d in "$ENVS_DIR"/*/; do
        e=$(basename "$d")
        # shellcheck disable=SC2139  # expand at definition time on purpose
        alias "$e"="source $ENVS_DIR/$e/bin/activate"
    done
fi

# Set Python enviourment: modules (relative to $SOFTWARE) added to PYTHONPATH. Default list; a host profile
# (.env/hosts/) can add to it with python_module_extra=(...) or replace it by setting python_module=(...).
if [[ -z ${python_module+x} ]]; then
    python_module=(
        "nuradio"
        "rnog/daq/mattak/py"
    )
fi
python_module+=(${python_module_extra[@]+"${python_module_extra[@]}"})

# export PYTHONPATH=  # Reset pythonpath
for m in "${python_module[@]}"; do
    path_append PYTHONPATH "$SOFTWARE/$m"
done

