# shellcheck shell=bash
# Default profile on macOS (the personal laptop).
DOTFILES_NVIM_AI="claudecode minuet"
DEFAULT_ENV="py315"  # Homebrew ROOT is built for Python 3.15

# for desy login
alias tssh='totp ssh'
alias tscp='totp scp'
alias kinit-desy="kinit --keychain --lifetime=25h --renewable fschluet@IFH.DE"

# put time token in clipboard
alias mfa='cat ~/.ssh/mfa.desy.de| oathtool - --totp -b -d 6 -s 30 | pbcopy'

alias imgcat="/Users/felix/software/imgcat"

alias ssh_greenland="/Users/felix/software/python/start-greenland-session.py"

alias mount_linux="sudo ext4fuse /dev/disk4s1 Linux/ -o allow_other"
export HOMEBREW_NO_ENV_HINTS=1

# Extra PYTHONPATH modules (relative to $SOFTWARE), added to the default list in .env/env; uncomment as needed
python_module_extra=(

    "python/radiotools"
    "python/cr-pulse-interpolator/src"
    "python/RadioPropa/radiopropa/install/lib/python3.11/site-packages/radiopropa"
    "python/radioanalysis"
    
    "rnog/daq/mattak/py"
    "rnog/daq/stationrc/"
    "rnog/analysis/analysis-tools"
    "rnog/repos/antenna-positioning"

    "../work/ant/ant"
    "../work/rnog/deepcr/src"

    # "proposal/build/package/lib/"

    # # IceCube
    # "icecube/toise" "icecube/ic3-labels" "icecube/event-generator"
    # "ehe/EHE_simulations/photon_propagation"

)

export RNO_G_DATA="${RNO_G_DATA:-$HOME/work/rnog/data/full}"
export RNO_G_INSTALL_DIR="${SOFTWARE:-$HOME/software}/rnog/daq/install"  # $SOFTWARE is not set yet here

alias cs="~/.claude/scripts/claude-sessions/cs"

KICONNECT_KEY="$(security find-generic-password -s campus-ki -w)"
export KICONNECT_KEY
