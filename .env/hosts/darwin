# shellcheck shell=bash
# Default profile on macOS (the personal laptop).
DOTFILES_NVIM_AI="claudecode minuet"

# for desy login
alias tssh='totp ssh'
alias tscp='totp scp'
alias kinit-desy="kinit --keychain --lifetime=25h --renewable fschluet@IFH.DE"

# put time token in clipboard
alias mfa='cat ~/.ssh/mfa.desy.de| oathtool - --totp -b -d 6 -s 30 | pbcopy'

alias imgcat="/Users/felix/software/imgcat"

alias ssh_greenland="/Users/felix/software/python/start-greenland-session.py"

alias mount_linux="sudo ext4fuse /dev/disk4s1 Linux/ -o allow_other"
export HOMEBREW_NO_ENV_HINTS=1
