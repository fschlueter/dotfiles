export ENVS_DIR="/scratch/fschlueter/envs"

export ROOT_SETUP="$HOME/scratch/root/install/bin/thisroot.sh"  # also used by ~/.claude/scripts/run-with-root.sh
alias thisroot=". $ROOT_SETUP"

alias parallel="~/.local/bin/parallel"
alias augerenv='eval "$(/scratch/fschlueter/auger/ape/ape sh externals --rc=/scratch/fschlueter/auger/ape/ape.rc)"'

offline() {
  export AUGEROFFLINEROOT=/scratch/fschlueter/auger/offline/install
  eval "$($AUGEROFFLINEROOT/bin/auger-offline-config --env-sh)"
  export PATH=$ROOTSYS/bin:$PATH
}
