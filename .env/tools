# shellcheck shell=bash
# Core CLI tools (fzf, zoxide, uv), installed if missing when sourced
# (macOS: Homebrew, Linux: official installers/release binaries into ~/.local/bin, no sudo).
# Also defines `_unzip`, `_have` and `_glibc_at_least`, used by the installers in .env/nvim and .env/yazi (this file is sourced first).

# Usage: _have CMD. True if CMD is an executable on PATH, ignoring functions and aliases (bash + zsh).
function _have() {
	if [[ -n ${ZSH_VERSION-} ]]; then whence -p "$1"; else type -P "$1"; fi >/dev/null
}

# Usage: _glibc_at_least X.Y. True if glibc is at least that version (or unknown, e.g. musl).
function _glibc_at_least() {
	local v
	v="$(getconf GNU_LIBC_VERSION 2>/dev/null)" || return 0
	v="${v#glibc }"
	[[ "$(printf '%s\n%s\n' "$1" "$v" | sort -V | head -n 1)" == "$1" ]]
}

# Usage: _unzip ARCHIVE DIR. Bare servers often lack `unzip`; fall back to python3.
function _unzip() {
	if command -v unzip >/dev/null; then
		unzip -q "$1" -d "$2"
	elif command -v python3 >/dev/null; then
		python3 -m zipfile -e "$1" "$2"
	else
		echo "Need unzip or python3 to extract $1." >&2
		return 1
	fi
}

function _install_fzf() {
	echo "fzf not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install fzf
		return
	fi

	local arch tmp ver ret
	case "$(uname -m)" in
		x86_64) arch=amd64 ;;
		aarch64 | arm64) arch=arm64 ;;
		*) echo "No prebuilt fzf for $(uname -m)." >&2; return 1 ;;
	esac
	ver="$(curl -fsSLI --connect-timeout 10 -o /dev/null -w '%{url_effective}' \
		https://github.com/junegunn/fzf/releases/latest)" || return
	ver="${ver##*/v}"
	tmp="$(mktemp -d)"
	curl -fsSL --connect-timeout 10 -o "$tmp/fzf.tar.gz" \
		"https://github.com/junegunn/fzf/releases/download/v$ver/fzf-$ver-linux_$arch.tar.gz" \
		&& tar -xzf "$tmp/fzf.tar.gz" -C "$tmp" \
		&& mkdir -p "$HOME/.local/bin" \
		&& install -m 755 "$tmp/fzf" "$HOME/.local/bin/"
	ret=$?
	rm -rf "$tmp"
	return $ret
}

function _install_zoxide() {
	echo "zoxide not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install zoxide
	else
		# Installs to ~/.local/bin by default (needs curl and tar)
		curl -fsSL --connect-timeout 10 \
			https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash
	fi
}

function _install_uv() {
	echo "uv not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install uv
	else
		curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
	fi
}

# Failures are not fatal: the shell stays usable without these tools
command -v fzf >/dev/null || _install_fzf || echo "fzf install failed." >&2
command -v zoxide >/dev/null || _install_zoxide || echo "zoxide install failed." >&2
command -v uv >/dev/null || _install_uv || echo "uv install failed." >&2
