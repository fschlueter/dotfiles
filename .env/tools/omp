# shellcheck shell=bash
# Prompt engine

dot_install_omp() {
    echo "oh-my-posh not found, installing ..."
    local arch
    case "$(uname -m)" in
        x86_64) arch=amd64 ;;
        aarch64 | arm64) arch=arm64 ;;
        *) echo "No prebuilt oh-my-posh for $(uname -m)." >&2; return 1 ;;
    esac
    # The binary only; the official install.sh additionally needs unzip (for the bundled themes, unused here)
    mkdir -p "$HOME/.local/bin" \
        && curl -fsSL --connect-timeout 10 -o "$HOME/.local/bin/oh-my-posh.tmp" \
            "https://cdn.ohmyposh.dev/releases/latest/posh-linux-$arch" \
        && chmod 755 "$HOME/.local/bin/oh-my-posh.tmp" \
        && mv "$HOME/.local/bin/oh-my-posh.tmp" "$HOME/.local/bin/oh-my-posh"
}

if ! command -v oh-my-posh >/dev/null && [[ ${DOTFILES_AUTO_INSTALL-1} != 0 ]]; then
    if [[ "$OSTYPE" == darwin* ]]; then
        echo "oh-my-posh not found, installing ..."
        brew install jandedobbeleer/oh-my-posh/oh-my-posh
    else
        dot_install_omp
    fi
fi

# CPU (and on macOS GPU) usage for the prompt: read the cache from the previous sample
# (no fork), then refresh it in the background. Must be registered before omp init.
# Cache lines: CPU %, then GPU % (macOS) or the previous /proc/stat totals "busy total" (Linux).
_omp_sysload() {
    local f="${XDG_CACHE_HOME:-$HOME/.cache}/ohmyposh/sysload" cpu="" second=""
    [[ -r $f ]] && { read -r cpu; read -r second; } < "$f"
    export OMP_CPU=$cpu
    [[ "$OSTYPE" == darwin* ]] && export OMP_GPU=$second
    (  # subshell: a bare `&` prints "[1] pid" in interactive shells
    {
        if [[ "$OSTYPE" == darwin* ]]; then
            local ncpu gpu
            ncpu=$(sysctl -n hw.ncpu)
            cpu=$(ps -A -o %cpu | awk -v n="$ncpu" 'NR>1{s+=$1} END{s=s/n; printf "%d", (s>100?100:s)}')
            gpu=$(ioreg -r -c IOAccelerator | grep -o '"Device Utilization %"=[0-9]*' | head -1 | cut -d= -f2)
            printf '%s\n%s\n' "$cpu" "$gpu" > "$f"
        else
            local pct=0 skip u n s i io irq sirq st busy total pbusy=0 ptotal=0
            read -r skip u n s i io irq sirq st _ < /proc/stat
            busy=$((u + n + s + irq + sirq + st))
            total=$((busy + i + io))
            [[ -n $second ]] && read -r pbusy ptotal <<< "$second"
            if ((total > ptotal)); then
                pct=$(((busy - pbusy) * 100 / (total - ptotal)))
            fi
            printf '%s\n%s %s\n' "$pct" "$busy" "$total" > "$f"
        fi
    } >/dev/null 2>&1 &
    )
}
if [[ "$OSTYPE" == darwin* || -r /proc/stat ]]; then
    mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/ohmyposh"
    if [[ -n ${ZSH_VERSION-} ]]; then
        autoload -Uz add-zsh-hook
        add-zsh-hook precmd _omp_sysload
    elif [[ -n ${BASH_VERSION-} ]]; then
        PROMPT_COMMAND="_omp_sysload${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
    fi
fi

# bash < 5.1 only runs PROMPT_COMMAND[0], but the oh-my-posh init appends _omp_hook as a further array element
# (so the prompt never renders). Flatten to one string, hook first so it sees the real exit status.
_omp_flatten_prompt_command() {
    local pc="_omp_hook" c
    for c in "${PROMPT_COMMAND[@]}"; do
        [[ $c == _omp_hook ]] || pc+=";$c"
    done
    unset PROMPT_COMMAND
    PROMPT_COMMAND=$pc
}

if command -v oh-my-posh >/dev/null; then
    eval "$(oh-my-posh init "${ZSH_VERSION:+zsh}${BASH_VERSION:+bash}" --config "$HOME/.config/ohmyposh/omp.toml")"
    if [[ -n ${BASH_VERSION-} ]] && ((BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 1))); then
        _omp_flatten_prompt_command
    fi
fi
