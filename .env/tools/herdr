# shellcheck shell=bash
# Terminal workspace manager for coding agents (~/.config/herdr/config.toml).
# herdr is installed on first use with the official installer (checksum-verified binary into ~/.local/bin, no sudo;
# same on macOS and Linux); `herdr update` updates it in place. Shell completion is cached and regenerated after updates.
#
# Key bindings (prefix = ctrl+s; defaults unless noted, full list in config.toml):
#   prefix+?          help                 prefix+s          settings
#   prefix+q          detach               prefix+shift+r    reload config
#   prefix+w          workspace picker     prefix+g          goto
#   prefix+shift+n    new workspace        prefix+shift+g    new worktree
#   prefix+shift+w    rename workspace     prefix+shift+d    close workspace
#   prefix+shift+1..9 workspace N (custom)
#   prefix+c          new tab              prefix+shift+t    rename tab
#   prefix+n / p      next / previous tab  prefix+1..9       tab N
#   prefix+shift+x    close tab
#   prefix+v          split vertical       prefix+minus      split horizontal
#   prefix+h/j/k/l    focus pane           prefix+tab        cycle panes (shift+tab back)
#   prefix+x          close pane           prefix+z          zoom pane
#   prefix+r          resize mode          prefix+shift+p    rename pane
#   prefix+e          herdr-nvim sidebar   prefix+o          herdr-nvim file picker (both custom)
#   prefix+shift+e    edit scrollback      prefix+shift+o    open notification target (both moved)
#   prefix+b          toggle sidebar

function dot_install_herdr() {
	echo "herdr not found, installing ..."
	curl -fsSL --connect-timeout 10 https://herdr.dev/install.sh | HERDR_INSTALL_DIR="$HOME/.local/bin" sh
}

# Pane colors: while herdr is attached, the outer terminal (Ghostty) uses a different Ghostty theme, set through
# OSC 4/10/11/12 escape codes and reset afterwards (OSC 104/110/111/112). herdr reads the host colors when it starts.
# The theme name is persisted by `herdr-theme` in ~/.config/ghostty/theme-herdr (empty or missing: Rose Pine).
_herdr_theme_state="$HOME/.config/ghostty/theme-herdr"

# Prints the path of Ghostty theme $1 (own themes first, then Ghostty's bundled ones)
function _herdr_theme_file() {
	local d
	for d in "$HOME/.config/ghostty/themes" /Applications/Ghostty.app/Contents/Resources/ghostty/themes \
		/usr/share/ghostty/themes /usr/local/share/ghostty/themes; do
		[[ -f "$d/$1" ]] && { echo "$d/$1"; return; }
	done
	return 1
}

function _herdr_colors_set() {
	local name file e=$'\e' b=$'\a'
	name="$(cat "$_herdr_theme_state" 2>/dev/null)"
	file="$(_herdr_theme_file "${name:-Rose Pine}")" || return 0
	# "palette = 3=#rrggbb" or "palette = 3 = #rrggbb" -> OSC 4; background/foreground/cursor-color -> OSC 11/10/12
	sed -nE \
		-e "s/^palette *= *([0-9]+) *= *#?([0-9a-fA-F]{6}).*/${e}]4;\1;#\2${b}/p" \
		-e "s/^foreground *= *#?([0-9a-fA-F]{6}).*/${e}]10;#\1${b}/p" \
		-e "s/^background *= *#?([0-9a-fA-F]{6}).*/${e}]11;#\1${b}/p" \
		-e "s/^cursor-color *= *#?([0-9a-fA-F]{6}).*/${e}]12;#\1${b}/p" \
		"$file" | tr -d '\n' >/dev/tty
}

function _herdr_colors_reset() {
	printf '\e]104\a\e]110\a\e]111\a\e]112\a' >/dev/tty
}

# Usage: herdr-theme [NAME]. Without NAME: show the current theme. Applies on the next attach (detach: prefix+q).
function herdr-theme() {
	if [[ -z ${1-} ]]; then
		local name
		name="$(cat "$_herdr_theme_state" 2>/dev/null)"
		echo "herdr pane theme: ${name:-Rose Pine}"
		echo "e.g. herdr-theme 'Rose Pine' | 'Rose Pine Moon' | 'Amber Contrast' | 'Trapped in Amber'"
		return
	fi
	_herdr_theme_file "$1" >/dev/null || { echo "No Ghostty theme named '$1'." >&2; return 1; }
	echo "$1" >"$_herdr_theme_state"
	echo "Saved; applies the next time herdr attaches."
}

function herdr() {
	dot_have herdr || dot_install_herdr || return
	# Recolor only when this call attaches the TUI (`herdr`, `herdr --session/--remote ...`, `herdr session attach`)
	# from outside herdr, on a terminal
	if [[ ${HERDR_ENV-} != 1 && -t 1 ]] && { [[ $# -eq 0 || $1 == --session || $1 == --remote ]] \
		|| [[ ${1-} == session && ${2-} == attach ]]; }; then
		_herdr_colors_set
		command herdr "$@"
		local ret=$?
		_herdr_colors_reset
		return $ret
	fi
	command herdr "$@"
}

# Completion (zsh: after compinit, the generated file registers itself via compdef; bash: complete -F)
if dot_have herdr; then
	if [[ -n ${ZSH_VERSION-} ]]; then _herdr_bin="$(whence -p herdr)"; else _herdr_bin="$(type -P herdr)"; fi
	_herdr_comp="$HOME/.cache/herdr/completion.$_sh"
	if [[ ! -s "$_herdr_comp" || "$_herdr_bin" -nt "$_herdr_comp" ]]; then
		mkdir -p "${_herdr_comp%/*}" && "$_herdr_bin" completion "$_sh" >"$_herdr_comp" 2>/dev/null
	fi
	[[ -s "$_herdr_comp" ]] && source "$_herdr_comp"
	unset _herdr_bin _herdr_comp
fi
