# shellcheck shell=bash
# Worktrunk (`wt`): git worktree manager (~/.config/worktrunk/config.toml). Installed on first call if missing
# (macOS: Homebrew, Linux: static musl release binary into ~/.local/bin, no sudo).
# Its shell integration defines a `wt` function that cd's into the switched-to worktree.
#   wth <branch> [wt switch args]   switch/create, then open the worktree in its own herdr workspace (wt-herdr)

function dot_install_wt() {
	echo "wt (worktrunk) not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install worktrunk
		return
	fi

	# Releases ship only .tar.xz (needs tar with xz support)
	local name tmp ret
	case "$(uname -m)" in
		x86_64) name=worktrunk-x86_64-unknown-linux-musl ;;
		aarch64 | arm64) name=worktrunk-aarch64-unknown-linux-musl ;;
		*) echo "No prebuilt wt for $(uname -m)." >&2; return 1 ;;
	esac
	tmp="$(mktemp -d)"
	curl -fsSL --connect-timeout 10 -o "$tmp/wt.tar.xz" \
		"https://github.com/max-sixty/worktrunk/releases/latest/download/$name.tar.xz" \
		&& tar -xJf "$tmp/wt.tar.xz" -C "$tmp" \
		&& mkdir -p "$HOME/.local/bin" \
		&& install -m 755 "$tmp/$name/wt" "$HOME/.local/bin/"
	ret=$?
	rm -rf "$tmp"
	return $ret
}

function _dot_wt_init() {
	eval "$(command wt config shell init "${ZSH_VERSION:+zsh}${BASH_VERSION:+bash}")"
}

if dot_have wt; then
	_dot_wt_init
else
	# First call installs wt, replaces this stub with the real integration and runs the command
	function wt() {
		dot_install_wt && dot_have wt || return
		unset -f wt
		_dot_wt_init
		wt "$@"
	}
fi

function wth() {
	wt switch --no-cd "$@" -x wt-herdr
}
