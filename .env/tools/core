# shellcheck shell=bash
# Core CLI tools (fzf, zoxide, uv), installed if missing when sourced
# (macOS: Homebrew, Linux: official installers/release binaries into ~/.local/bin, no sudo).
# Also defines `dot_unzip`, `dot_have` and `dot_glibc_at_least`, used by the installers in .env/tools/nvim and .env/tools/yazi (this file is sourced first),
# `path_append`/`path_prepend` for colon-separated variables, and sets the base PATH.
# Helper names start with `dot_`, not `_`: Claude Code's shell snapshot (observed 2026-10) drops functions
# whose name starts with a single `_`, so wrappers like herdr() or nvim() failed there with "_have: command not found".

# Add a dir to a colon-separated path variable, skipping duplicates (bash + zsh).
# path_append also skips entries that do not exist (-e, so zip/egg files in PYTHONPATH work too).
# Usage: path_append VAR DIR / path_prepend VAR DIR
function path_append() {
	local cur
	[[ -e $2 ]] || return 0
	eval "cur=\${$1-}"
	case ":$cur:" in
		*":$2:"*) ;;
		*) export "$1=${cur:+$cur:}$2" ;;
	esac
}
function path_prepend() {
	local cur
	eval "cur=\${$1-}"
	case ":$cur:" in
		*":$2:"*) ;;
		*) export "$1=$2${cur:+:$cur}" ;;
	esac
}

# Base locations for user-installed tools; set before the installers below, which put tools there.
path_prepend PATH "$HOME/.local/bin"
if [[ "$OSTYPE" == darwin* ]]; then
	path_prepend PATH /opt/homebrew/sbin
	path_prepend PATH /opt/homebrew/bin
fi

# Usage: dot_have CMD. True if CMD is an executable on PATH, ignoring functions and aliases (bash + zsh).
function dot_have() {
	if [[ -n ${ZSH_VERSION-} ]]; then whence -p "$1"; else type -P "$1"; fi >/dev/null
}

# Usage: dot_glibc_at_least X.Y. True if glibc is at least that version (or unknown, e.g. musl).
function dot_glibc_at_least() {
	local v
	v="$(getconf GNU_LIBC_VERSION 2>/dev/null)" || return 0
	v="${v#glibc }"
	[[ "$(printf '%s\n%s\n' "$1" "$v" | sort -V | head -n 1)" == "$1" ]]
}

# Usage: dot_unzip ARCHIVE DIR. Bare servers often lack `unzip`; fall back to python3.
function dot_unzip() {
	if command -v unzip >/dev/null; then
		unzip -q "$1" -d "$2"
	elif command -v python3 >/dev/null; then
		python3 -m zipfile -e "$1" "$2"
	else
		echo "Need unzip or python3 to extract $1." >&2
		return 1
	fi
}

function dot_install_fzf() {
	echo "fzf not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install fzf
		return
	fi

	local arch tmp ver ret
	case "$(uname -m)" in
		x86_64) arch=amd64 ;;
		aarch64 | arm64) arch=arm64 ;;
		*) echo "No prebuilt fzf for $(uname -m)." >&2; return 1 ;;
	esac
	ver="$(curl -fsSLI --connect-timeout 10 -o /dev/null -w '%{url_effective}' \
		https://github.com/junegunn/fzf/releases/latest)" || return
	ver="${ver##*/v}"
	tmp="$(mktemp -d)"
	curl -fsSL --connect-timeout 10 -o "$tmp/fzf.tar.gz" \
		"https://github.com/junegunn/fzf/releases/download/v$ver/fzf-$ver-linux_$arch.tar.gz" \
		&& tar -xzf "$tmp/fzf.tar.gz" -C "$tmp" \
		&& mkdir -p "$HOME/.local/bin" \
		&& install -m 755 "$tmp/fzf" "$HOME/.local/bin/"
	ret=$?
	rm -rf "$tmp"
	return $ret
}

function dot_install_zoxide() {
	echo "zoxide not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install zoxide
	else
		# Installs to ~/.local/bin by default (needs curl and tar)
		curl -fsSL --connect-timeout 10 \
			https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash
	fi
}

function dot_install_uv() {
	echo "uv not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install uv
	else
		curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
	fi
}

# Failures are not fatal: the shell stays usable without these tools. Skipped when DOTFILES_AUTO_INSTALL=0 (.env/host).
if [[ ${DOTFILES_AUTO_INSTALL-1} != 0 ]]; then
	command -v fzf >/dev/null || dot_install_fzf || echo "fzf install failed." >&2
	command -v zoxide >/dev/null || dot_install_zoxide || echo "zoxide install failed." >&2
	command -v uv >/dev/null || dot_install_uv || echo "uv install failed." >&2
fi
