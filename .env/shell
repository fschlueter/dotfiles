# shellcheck shell=bash
# Interactive setup shared by .zshrc and .bashrc (each sources it after its shell-specific parts).
# Keep it bash-compatible; anything zsh- or bash-only belongs in the respective rc file.
_sh="${ZSH_VERSION:+zsh}${BASH_VERSION:+bash}"

# Aliases
alias ll="ls -l"
if [[ "$OSTYPE" == darwin* ]]; then
    alias ls="gls --color=auto"  # GNU ls honors LS_COLORS; macOS /bin/ls does not
else
    alias ls="ls --color=auto"
fi
alias grep="grep --color=auto"

# Ghostty on the laptop sets TERM=xterm-ghostty, which servers usually have no terminfo for
if [[ "$TERM" == xterm-ghostty ]] && ! infocmp "$TERM" >/dev/null 2>&1; then
    export TERM=xterm-256color
fi

### Helpers, PATH and core tools

# path helpers, _have & co., base PATH; installs fzf, zoxide and uv if missing
source ~/.env/tools/core

### Colors
if [[ "$OSTYPE" == darwin* ]]; then
    eval "$(gdircolors -b)"
else
    eval "$(dircolors -b)"
fi
LS_COLORS+=":fi=92"  # regular files: bright green (Ghostty palette 10)

### Shell integrations


# fuzzy finder
if _have fzf && _fzf_init="$(fzf "--$_sh" 2>/dev/null)"; then  # fzf < 0.48 has no --bash
    eval "$_fzf_init"
fi
unset _fzf_init

# fd is optional (Debian/Ubuntu name it fdfind); without it fzf falls back to find
if _have fd; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --exclude .cache . ~'
elif _have fdfind; then
    export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --exclude .git --exclude .cache . ~'
fi
[[ -n ${FZF_DEFAULT_COMMAND-} ]] && export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# replace cd with zoxide
_have zoxide && eval "$(zoxide init "$_sh" --cmd cd)"

# uv completion (bash; the zsh setup has no uv completion yet)
if [[ $_sh == bash ]] && _have uv; then
    eval "$(uv generate-shell-completion bash)"
fi

# prompt engine
source ~/.env/tools/omp

### Programs

# file manager (`y`)
source ~/.env/tools/yazi

# editor (`nvim`)
source ~/.env/tools/nvim
alias vim=nvim

### Set up working environments

source ~/.env/env  # coding and software environment
unset _sh
