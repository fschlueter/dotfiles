# shellcheck shell=bash
# Editor: Neovim with LazyVim (~/.config/nvim). lazy.nvim installs the plugins on first start, pinned in lazy-lock.json.
# nvim and tree-sitter-cli (for nvim-treesitter) are installed on first use of `nvim`
# (macOS: Homebrew, Linux: official release binaries into ~/.local, no sudo).
# Checks use `_have` (.env/tools): it skips the `nvim` function below and sees new binaries without `rehash`.

# Default editor for other programs (yazi, git, ...); they call the binary, not the `nvim` function
export EDITOR=nvim
export VISUAL=nvim

function _install_nvim() {
	echo "nvim not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install neovim
		return
	fi

	# The official tarball needs glibc >= 2.34 (RHEL/Alma 9+, Debian 12+, Ubuntu 22.04+)
	if ! _glibc_at_least 2.34; then
		echo "glibc too old for the prebuilt nvim; install Neovim >= 0.11 another way." >&2
		return 1
	fi
	local arch tmp ret
	case "$(uname -m)" in
		x86_64) arch=x86_64 ;;
		aarch64 | arm64) arch=arm64 ;;
		*) echo "No prebuilt nvim for $(uname -m)." >&2; return 1 ;;
	esac
	# The release is a bin/lib/share tree, kept in ~/.local/opt/nvim and linked into ~/.local/bin
	tmp="$(mktemp -d)"
	curl -fsSL --connect-timeout 10 \
		"https://github.com/neovim/neovim/releases/latest/download/nvim-linux-$arch.tar.gz" \
		| tar xz -C "$tmp" \
		&& mkdir -p "$HOME/.local/opt" "$HOME/.local/bin" \
		&& rm -rf "$HOME/.local/opt/nvim" \
		&& mv "$tmp/nvim-linux-$arch" "$HOME/.local/opt/nvim" \
		&& ln -sf "$HOME/.local/opt/nvim/bin/nvim" "$HOME/.local/bin/nvim"
	ret=$?
	rm -rf "$tmp"
	return $ret
}

function _install_tree_sitter() {
	echo "tree-sitter not found, installing ..."
	if [[ "$OSTYPE" == darwin* ]]; then
		brew install tree-sitter-cli
		return
	fi

	# The prebuilt binary needs glibc >= 2.39 (RHEL/Alma 10, Debian 13, Ubuntu 24.04+); older hosts build it with cargo if present
	if ! _glibc_at_least 2.39; then
		if command -v cargo >/dev/null; then
			cargo install --locked --root "$HOME/.local" tree-sitter-cli
		else
			echo "glibc too old for the prebuilt tree-sitter; install cargo to build it, parsers can't be built until then." >&2
			mkdir -p "$HOME/.cache" && touch "$HOME/.cache/no-tree-sitter"  # checked by `nvim` below
			return 1
		fi
		return
	fi
	local arch tmp ret
	case "$(uname -m)" in
		x86_64) arch=x64 ;;
		aarch64 | arm64) arch=arm64 ;;
		*) echo "No prebuilt tree-sitter for $(uname -m)." >&2; return 1 ;;
	esac
	tmp="$(mktemp -d)"
	curl -fsSL --connect-timeout 10 -o "$tmp/tree-sitter.zip" \
		"https://github.com/tree-sitter/tree-sitter/releases/latest/download/tree-sitter-cli-linux-$arch.zip" \
		&& _unzip "$tmp/tree-sitter.zip" "$tmp" \
		&& mkdir -p "$HOME/.local/bin" \
		&& install -m 755 "$tmp/tree-sitter" "$HOME/.local/bin/"
	ret=$?
	rm -rf "$tmp"
	# Drop the binary if it can't run, so we don't retry on every start
	if [[ $ret -eq 0 ]] && ! "$HOME/.local/bin/tree-sitter" --version >/dev/null 2>&1; then
		echo "tree-sitter does not run here (unexpected); parsers can't be built." >&2
		rm -f "$HOME/.local/bin/tree-sitter"
		mkdir -p "$HOME/.cache" && touch "$HOME/.cache/no-tree-sitter"  # checked by `nvim` below
		ret=1
	fi
	return $ret
}

function nvim() {
	_have nvim || _install_nvim || return
	# tree-sitter is only needed for parsers, so not fatal
	_have tree-sitter || [[ -e "$HOME/.cache/no-tree-sitter" ]] || _install_tree_sitter
	command nvim "$@"
}
