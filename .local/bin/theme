#!/usr/bin/env bash
# Select the Ghostty color theme that the terminal, herdr, borders and sketchybar follow.
# Usage: theme                      show the current themes and the repo's own ones
#        theme NAME                 terminal theme (Ghostty outside herdr; also herdr when it is "same")
#        theme --herdr NAME|same    Herdr app theme ("same": follow the terminal theme)
#        theme --name terminal|herdr   print the effective theme name (for scripts)
#        theme --file terminal|herdr   print the effective theme file (for scripts)
#        theme --apply              reapply the current themes (borders, herdr app)
# State: ~/.config/ghostty/theme.ghostty (`theme = NAME`, included by config.ghostty)
#        and ~/.config/ghostty/theme-herdr (NAME, or empty/"same"). Both are gitignored.
set -euo pipefail

dir="$HOME/.config/ghostty"
terminal_state="$dir/theme.ghostty"
herdr_state="$dir/theme-herdr"
theme_dirs=("$dir/themes" /Applications/Ghostty.app/Contents/Resources/ghostty/themes
    /usr/share/ghostty/themes /usr/local/share/ghostty/themes)

# Prints the file of theme $1 (own themes first, then Ghostty's bundled ones)
theme_file() {
    local d
    for d in "${theme_dirs[@]}"; do
        [[ -f "$d/$1" ]] && { echo "$d/$1"; return; }
    done
    return 1
}

# Last `theme = NAME` line of file $1
theme_line() {
    sed -nE 's/^theme *= *(.*[^ ]) *$/\1/p' "$1" 2>/dev/null | tail -1
}

terminal_name() {
    local name
    name="$(theme_line "$terminal_state")"
    [[ -z $name ]] && name="$(theme_line "$dir/config.ghostty")"
    echo "${name:-Matrix Contrast}"
}

herdr_name() {
    local name
    name="$(cat "$herdr_state" 2>/dev/null || true)"
    if [[ -z $name || $name == same ]]; then terminal_name; else echo "$name"; fi
}

name_of() {
    case "${1-}" in
        terminal) terminal_name ;;
        herdr) herdr_name ;;
        *) echo "expected terminal or herdr, got '${1-}'" >&2; exit 2 ;;
    esac
}

# Herdr app (GUI, can't read Ghostty's palette): writes the herdr theme as herdr-app's themes/ghostty.json,
# which the app reloads on save. Accent = slot 5 (magenta), selected sidebar row = slot 0; agent states
# (radar mod) = working 3 (yellow), blocked 1 (red), done 2 (green), idle 8 (bright black), unknown 5.
herdr_app_theme() {
    local home="${HERDR_APP_HOME:-$HOME/.config/herdr-app}" file
    [[ -d $home ]] || return 0
    file="$(theme_file "$(herdr_name)")" || return 0
    mkdir -p "$home/themes"
    awk '
        { sub(/[ \t]*#[^0-9a-fA-F].*$/, "") }  # trailing comments (not the # of a color)
        /^palette *=/ { if (match($0, /[0-9]+ *= *#?[0-9a-fA-F]{6}/)) { s = substr($0, RSTART, RLENGTH)
            n = s; sub(/ *=.*/, "", n); c = s; sub(/.*= *#?/, "", c); pal[n + 0] = "#" c } }
        /^(background|foreground|cursor-color|selection-background) *=/ { k = $0; sub(/ *=.*/, "", k)
            if (match($0, /#?[0-9a-fA-F]{6} *$/)) { c = substr($0, RSTART, RLENGTH); sub(/#/, "", c); sub(/ *$/, "", c); v[k] = "#" c } }
        END {
            bg = v["background"] ? v["background"] : "#000000"; fg = v["foreground"] ? v["foreground"] : "#ffffff"
            printf "{\n  \"background\": \"%s\",\n  \"foreground\": \"%s\",\n", bg, fg
            printf "  \"selection\": \"%s\",\n", v["selection-background"] ? v["selection-background"] : (pal[8] ? pal[8] : fg)
            printf "  \"cursor\": \"%s\",\n  \"ansi\": [", v["cursor-color"] ? v["cursor-color"] : fg
            for (i = 0; i < 16; i++) printf "%s\"%s\"", (i ? ", " : ""), (pal[i] ? pal[i] : fg)
            printf "],\n  \"colors\": {\n"
            printf "    \"accent\": \"%s\",\n    \"selected\": \"%s\",\n", pal[5] ? pal[5] : fg, pal[0] ? pal[0] : bg
            printf "    \"working\": \"%s\",\n    \"blocked\": \"%s\",\n", P(3), P(1)
            printf "    \"done\": \"%s\",\n    \"idle\": \"%s\",\n", P(2), P(8)
            printf "    \"unknown\": \"%s\"\n  }\n}\n", P(5)
        }
        function P(i) { return pal[i] ? pal[i] : (pal[i % 8] ? pal[i % 8] : fg)
        }' "$file" >"$home/themes/ghostty.json.tmp" && mv "$home/themes/ghostty.json.tmp" "$home/themes/ghostty.json"
}

# Effects outside the state files: window borders and the herdr app use the herdr theme
apply() {
    [[ -x "$HOME/.config/borders/bordersrc" ]] && "$HOME/.config/borders/bordersrc" >/dev/null 2>&1 || true
    herdr_app_theme || true
}

check() {
    theme_file "$1" >/dev/null || { echo "No Ghostty theme named '$1'." >&2; exit 1; }
}

case "${1-}" in
    "")
        herdr_raw="$(cat "$herdr_state" 2>/dev/null || true)"
        echo "terminal: $(terminal_name)"
        echo "herdr:    $(herdr_name)$([[ -z $herdr_raw || $herdr_raw == same ]] && echo ' (same)')"
        own=("$dir"/themes/*)
        own=("${own[@]##*/}")
        printf 'own themes: %s' "${own[0]}"; printf ', %s' "${own[@]:1}"; echo
        echo "(plus Ghostty's bundled ones: ghostty +list-themes)"
        ;;
    --apply) apply ;;
    --name) name_of "${2-}" ;;
    --file) theme_file "$(name_of "${2-}")" ;;
    --herdr)
        [[ -n ${2-} ]] || { echo "usage: theme --herdr NAME|same" >&2; exit 2; }
        [[ $2 == same ]] || check "$2"
        echo "$2" >"$herdr_state"
        apply
        echo "herdr: $(herdr_name); the Herdr app follows at once."
        ;;
    -h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    -*) echo "unknown option '$1' (see theme --help)" >&2; exit 2 ;;
    *)
        check "$1"
        printf '# Written by the theme script (~/.local/bin/theme); gitignored.\ntheme = %s\n' "$1" >"$terminal_state"
        apply
        echo "terminal: $1. Reload Ghostty with Cmd+Shift+, ; the Herdr app follows if it is 'same'."
        ;;
esac
